# ── Sky Striker server config (local dev: copy to server/.env.local) ──
# Secrets (KEYCLOAK_CLIENT_SECRET, JWT_SECRET, DB password) can come from Vault instead:
# inject them as env vars, or render a dotenv file and set ENV_FILE=/path/to/file.

# Public URL of the game; Keycloak redirects back here after login.
APP_PORT=3100

# Database (compose builds MYSQL_URL from MYSQL_ROOT_PASSWORD when MYSQL_URL is unset)
MYSQL_ROOT_PASSWORD=change-me
# MYSQL_URL=mysql://user:password@host:3306/sky_striker

# Signs the game's session tokens. Changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Keycloak: confidential client with "Standard flow" + PKCE (S256)
KEYCLOAK_ISSUER=https://sso.example.com/realms/example
KEYCLOAK_CLIENT_ID=sky-striker
KEYCLOAK_CLIENT_SECRET=
# Comma-separated; must exactly match the client's Valid Redirect URIs (the game's URL)
KEYCLOAK_REDIRECT_URIS=https://sky-striker.example.com

# Dev-only username login without Keycloak — keep false in production
LOCAL_LOGIN=false

# Only for split dev setups (game served from another origin)
# CORS_ORIGIN=http://localhost:5847
